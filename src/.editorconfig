root = true

# Applies to every project under src/ (MSBuild stops at src/Directory.Build.props, so the
# repository's other projects are unaffected).
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Naming heuristics that fight the PDF vocabulary this API is built on. Disabled per file, with the
# rule and the reason, rather than globally.
[**/ValueObjects/PdfVersion.cs]
# CA1707: V1_4 .. V2_0 spell the version notation exactly as it appears in a PDF header.
dotnet_diagnostic.CA1707.severity = none

[**/ValueObjects/PageRange.cs]
# CA1720: Single is the natural name for "exactly one page", matching Enumerable.Single.
dotnet_diagnostic.CA1720.severity = none

[**/ValueObjects/PageSelection.cs]
# CA1720: Single is the natural name for "exactly one page", matching Enumerable.Single.
dotnet_diagnostic.CA1720.severity = none

[**/ValueObjects/PdfObjectViewKind.cs]
# CA1720: Integer, Real and String are the PDF object kinds as the standard and every reference manual
# name them; renaming them would make the projection disagree with the documents it describes.
dotnet_diagnostic.CA1720.severity = none

[**/ValueObjects/PdfPageLabeling.cs]
# CA1720: Decimal is the numbering style the PDF standard names /D and every reference manual calls the
# decimal style; renaming it would put the API at odds with the documents it writes and reads.
dotnet_diagnostic.CA1720.severity = none

[**/ValueObjects/PdfEditOperation.cs]
# S1694: an edit operation is a closed hierarchy of values that the engine switches over; an
# interface would let any type claim to be an operation the engine cannot execute.
dotnet_diagnostic.S1694.severity = none

# The three SonarCloud rules this repository answers with a decision rather than a change. Each silence is
# scoped to the file that carries the decision and each line carries // NOSONAR as well, so the server side
# of the gate reaches the same conclusion as a local build. Anything else the analyzer reports is a finding
# to fix, not to configure away.

# S101: the product name is SharpCorePDF, with PDF in capitals, so the type that registers it is named for
# the product. Renaming it would break the published API to satisfy an acronym heuristic.
[**/SharpCorePDFServiceCollectionExtensions.cs]
dotnet_diagnostic.S101.severity = none

# S1694: PdfObject is a closed hierarchy of file-level values. An interface would let any type claim to be
# one, while the parser, the writer and the copier all switch over the sealed set they know.
[**/Pdf/PdfObject.cs]
dotnet_diagnostic.S1694.severity = none

# S4790: MD5 is not a choice here. The PDF standard's encryption algorithms 1, 2, 3 and 5 specify it, and a
# reader that wrote SHA-256 instead could not open a document encrypted by any other producer.
[**/Pdf/PdfStandardSecurity.cs]
dotnet_diagnostic.S4790.severity = none
