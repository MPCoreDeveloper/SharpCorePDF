<Project>

  <!--
    Shared build defaults for every library under src/.

    Scoped to src/ on purpose: MSBuild stops walking upward at the first
    Directory.Build.props it finds, so the repository's other projects (tests/,
    examples/ and tools/) keep their own settings untouched.

    Multi-targeting mirrors Posseth.Global.UlidFactory: net10.0 (C# 14) plus
    net11.0 (C# 15, runtime-async).

    Both legs are supported and both ship in every package, so a .NET 10 caller
    loads lib/net10.0 and a .NET 11 caller loads lib/net11.0. net10.0 is a
    first-class target rather than a leftover: it is what keeps the packages
    installable by apps that have not moved to .NET 11 yet. Because there is no
    netstandard2.0 or net8.0 leg, an application on .NET 8 or .NET 9 cannot
    install these packages; adding that reach is a separate, deliberate change.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'net11.0'">preview</LangVersion>
    <LangVersion Condition="'$(TargetFramework)' != 'net11.0'">14.0</LangVersion>
    <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <Version>1.0.0-preview.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>MPCoreDeveloper</Authors>
    <Company>SharpCorePDF</Company>
    <Product>SharpCorePDF</Product>
    <Copyright>Copyright (c) 2026 MPCoreDeveloper</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/MPCoreDeveloper/SharpCorePDF</RepositoryUrl>
    <PackageProjectUrl>https://github.com/MPCoreDeveloper/SharpCorePDF</PackageProjectUrl>
    <PackageTags>pdf;merge;combine;pdf-merge;concatenate;ddd;dependency-injection;dotnet;net10;net11</PackageTags>
  </PropertyGroup>

  <!--
    The logo and this repository's README travel inside every package: the README is the page a feed
    shows for the package, and the icon is what a search result shows. Logo.jpg is the 2048 x 2048
    source; the icon is the 256 x 256 Logo-256.png, because nuget.org caps a package icon at 1 MB
    and the source JPEG is 1.49 MB.

    The paths are resolved from this file, so they work for every project under src/ without each
    project file having to repeat them.
  -->
  <PropertyGroup>
    <PackageIcon>Logo-256.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\Logo-256.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
