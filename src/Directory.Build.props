<Project>

  <!--
    Shared build defaults for every library under src/.

    Scoped to src/ on purpose: MSBuild stops walking upward at the first
    Directory.Build.props it finds, so the repository's other projects (tests/,
    examples/ and tools/) keep their own settings untouched.

    Multi-targeting mirrors Posseth.Global.UlidFactory: net10.0 (C# 14) plus
    net11.0 (C# 15, runtime-async).

    Both legs are supported and both ship in every package, so a .NET 10 caller
    loads lib/net10.0 and a .NET 11 caller loads lib/net11.0. net10.0 is a
    first-class target rather than a leftover: it is what keeps the packages
    installable by apps that have not moved to .NET 11 yet. Because there is no
    netstandard2.0 or net8.0 leg, an application on .NET 8 or .NET 9 cannot
    install these packages; adding that reach is a separate, deliberate change.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'net11.0'">preview</LangVersion>
    <LangVersion Condition="'$(TargetFramework)' != 'net11.0'">14.0</LangVersion>
    <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable;RS0016;RS0017</WarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Authors>MPCoreDeveloper</Authors>
    <Company>SharpCorePDF</Company>
    <Product>SharpCorePDF</Product>
    <Copyright>Copyright (c) 2026 MPCoreDeveloper</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/MPCoreDeveloper/SharpCorePDF</RepositoryUrl>
    <PackageProjectUrl>https://github.com/MPCoreDeveloper/SharpCorePDF</PackageProjectUrl>
    <PackageTags>pdf;merge;combine;pdf-merge;concatenate;ddd;dependency-injection;dotnet;net10;net11</PackageTags>

    <!--
      nuget.org renders this as the Release notes tab on every package page, and it is the one block a
      consumer reads before downloading. It stays a pointer rather than a copy: the changelog is the
      detail, and two copies of the same notes drift the moment one of them is edited.
    -->
    <PackageReleaseNotes>1.3.0 - The manual that ships with this repository is now generated by the library it documents: tools/SharpCorePDF.Manual prints the book headlessly and finishes it with SharpCorePDF's own reader, authoring surface and edit plan, so the running footer, the outline and the metadata are one plan and neither Python nor pypdf takes part. Fixes three faults a reader could see: a layer drawn under a graphics state the page leaves open (Chromium's print output states its transform outside a q, which put the manual's footer at a quarter of its size in the top-left corner), a footer anchor measured from the wrong edge, and a Quickstart that promised a container package it did not reference. Both legs (net10.0, net11.0) ship in one package. Details: https://github.com/MPCoreDeveloper/SharpCorePDF/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <!--
    The logo and this repository's README travel inside every package: the README is the page a feed
    shows for the package, and the icon is what a search result shows. Logo.jpg is the 2048 x 2048
    source; the icon is the 256 x 256 Logo-256.png, because nuget.org caps a package icon at 1 MB
    and the source JPEG is 1.49 MB.

    The paths are resolved from this file, so they work for every project under src/ without each
    project file having to repeat them.
  -->
  <PropertyGroup>
    <PackageIcon>Logo-256.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\Logo-256.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    The approved-API snapshot (architecture AD-2, PRD §9.5).

    PublicAPI.Shipped.txt is the frozen surface; PublicAPI.Unshipped.txt holds additions
    waiting for the next release. The snapshot changes only in the same commit as the
    surface change, and that diff is reviewed at every release. RS0016 (a public member the
    declared API does not list) and RS0017 (an entry that outlives its member) become build
    errors below, so neither can slip through review.

    Dev-time only: PrivateAssets="all" keeps the analyzer out of the package and out of a
    consumer's build. One pair of files per project is enough while there is a single
    shipped leg; the per-target split the analyzer supports becomes required the day a
    second target returns.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    SonarCloud's C# rules, run by the compiler instead of discovered by the server.

    The scanner analyses what this build produced, so the same rule set can run here: the analyzer is the
    dev-time half of "comply with the quality gate". An issue becomes visible at the line that causes it,
    before a pull request exists, rather than as a red gate after the push. PrivateAssets="all" keeps it
    out of every package and out of a consumer's build.

    The SonarCloud project (MPCoreDeveloper_SharpCorePDF) decides the gate; this only makes the rules
    reachable locally. A rule this repository decides not to follow is silenced where it occurs, with the
    reason on the line (`// NOSONAR`), never repo-wide.
  -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
  </ItemGroup>

</Project>
