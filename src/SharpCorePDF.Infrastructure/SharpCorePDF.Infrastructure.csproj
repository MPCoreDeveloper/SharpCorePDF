<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SharpCorePDF.Infrastructure</RootNamespace>
    <AssemblyName>SharpCorePDF.Infrastructure</AssemblyName>
    <Title>SharpCorePDF.Infrastructure</Title>
    <Description>Self-contained PDF engine for SharpCorePDF: reader (classic cross-reference tables, cross-reference streams and object streams), writer, the merging engine, and the authoring builder that writes pages, text with standard or embedded TrueType fonts, and PNG images. Depends on nothing but the .NET base class library.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpCorePDF.Domain\SharpCorePDF.Domain.csproj" />
    <ProjectReference Include="..\SharpCorePDF.Application\SharpCorePDF.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpCorePDF.Tests" />
  </ItemGroup>

</Project>
