<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SharpCorePDF.DependencyInjection</RootNamespace>
    <AssemblyName>SharpCorePDF.DependencyInjection</AssemblyName>
    <Title>SharpCorePDF.DependencyInjection</Title>
    <Description>Microsoft.Extensions.DependencyInjection registration for SharpCorePDF: one AddSharpCorePDF() call wires the merger, the inspector and the PDF engine, with optional configuration binding.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpCorePDF.Domain\SharpCorePDF.Domain.csproj" />
    <ProjectReference Include="..\SharpCorePDF.Application\SharpCorePDF.Application.csproj" />
    <ProjectReference Include="..\SharpCorePDF.Infrastructure\SharpCorePDF.Infrastructure.csproj" />
  </ItemGroup>

</Project>
